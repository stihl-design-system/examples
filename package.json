{
  "name": "examples",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite preview --port 3000",
    "prebuild": "node node_modules/@stihl-design-system/components/partials/copyAssets.js",
    "build": "vite build && tsc",
