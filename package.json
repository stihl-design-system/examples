    "formik": "^2.4.9",
    "globals": "^17.13.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.9",
    "react-hook-form": "^7.89.0",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "web-vitals": "^6.2.2"
